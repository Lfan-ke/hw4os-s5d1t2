-- Tb.bs — Bluespec Haskell (Classic/Haskell syntax) language test for the StarryOS
-- bluesv case (#764 "bluesv ... bluespec haskell"). bsc compiles this .bs (BH syntax,
-- distinct from .bsv SystemVerilog) to Verilog, simulated by iverilog on StarryOS.
-- Exercises BH constructs: typedef struct, pure function, Vector, polymorphic interface,
-- registers, rules, conditional Action — deterministic $display golden.
package Tb where

import Vector

-- pure function (Haskell-style)
square :: Bit 16 -> Bit 32
square x = zeroExtend x * zeroExtend x

-- struct typedef
struct Pair =
  a :: Bit 8
  b :: Bit 8
 deriving (Bits, Eq)

addPair :: Pair -> Bit 16
addPair p = zeroExtend p.a + zeroExtend p.b

interface Counter =
  inc   :: Action
  value :: Bit 8

mkCounter :: Module Counter
mkCounter =
  module
    cnt :: Reg (Bit 8) <- mkReg 0
    interface
      inc   = cnt := cnt + 1
      value = cnt

mkTb :: Module Empty
mkTb =
  module
    c :: Counter <- mkCounter
    i :: Reg (Bit 8) <- mkReg 0
    done :: Reg Bool <- mkReg False
    -- a Vector of 4 constants, summed
    let v :: Vector 4 (Bit 8)
        v = cons 1 (cons 2 (cons 3 (cons 4 nil)))
    rules
      "run": when (not done) ==>
        if i >= 8
          then do
            $display "BH_COUNT=%0d" c.value
            $display "BH_SQUARE=%0d" (square 9)
            $display "BH_PAIR=%0d" (addPair (Pair {a = 20; b = 22;}))
            $display "BH_VECSUM=%0d" (foldr (+) 0 v)
            $display "BH_SIM_OK"
            done := True
            $finish 0
          else do
            c.inc
            i := i + 1
