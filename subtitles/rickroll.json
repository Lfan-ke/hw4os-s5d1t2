{"font_size":0.4,"font_color":"#FFFFFF","background_alpha":0.5,"background_color":"#9C27B0","Stroke":"none","body":[{"from":18.82,"to":22.75,"location":2,"content":"우리는 연애한 경험이 있어"},{"from":22.75,"to":27.11,"location":2,"content":"당신과 나는 어떻게 해야 하는지도 알어"},{"from":27.11,"to":31.25,"location":2,"content":"나는 내 자신을 당신에게 바치는 뜻을 생각해"},{"from":31.25,"to":35.2,"location":2,"content":"당신은 다른 어떤 남자로부터도 이러한 사랑을 못 받겠어"},{"from":35.2,"to":40.44,"location":2,"content":"내가 어떻게 느끼는지 당신에게 말해주고 싶을 뿐이야"},{"from":40.44,"to":43.13,"location":2,"content":"당신이 이해하도록 하겠어"},{"from":43.13,"to":45.19,"location":2,"content":"당신을 절대로 포기하지 않아"},{"from":45.19,"to":47.26,"location":2,"content":"당신을 절대로 실망시키지 않아"},{"from":47.26,"to":51.51,"location":2,"content":"도망다니면서 당신을 절대로 혼자두지 않아"},{"from":51.51,"to":53.57,"location":2,"content":"당신을 절대로 울게 하지 않아"},{"from":53.57,"to":55.79,"location":2,"content":"당신에게 잘 있어라는 말을 절대로 말하지 않아"},{"from":55.79,"to":60.87,"location":2,"content":"당신에게 거짓말해서 당신을 절대로 아프게 하지 않아"},{"from":60.87,"to":65,"location":2,"content":"우리는 서로서로 오랫동안 알고 지냈어"},{"from":65,"to":69.37,"location":2,"content":"당신의 가슴은 아팠지만 당신은 너무 수줍워서 그것을 말을 못해"},{"from":69.37,"to":73.56,"location":2,"content":"마음 속에서 우리 둘은 무슨 일이 일어나는지 알어"},{"from":73.56,"to":77.37,"location":2,"content":"우리는 그 게임을 아니깐 그것을 시작해"},{"from":77.37,"to":82.56,"location":2,"content":"또 당신은 내가 어떻게 느끼는지 물어보면"},{"from":82.56,"to":85.3,"location":2,"content":"눈이 멀어서 그것을 보지 못한다고 말하지 말어"},{"from":85.3,"to":87.55,"location":2,"content":"당신을 절대로 포기하지 않아"},{"from":87.55,"to":89.65,"location":2,"content":"당신을 절대로 실망시키지 않아"},{"from":89.65,"to":93.96,"location":2,"content":"도망다니면서 당신을 절대로 혼자두지 않아"},{"from":93.96,"to":95.99,"location":2,"content":"당신을 절대로 울게 하지 않아"},{"from":95.99,"to":98.16,"location":2,"content":"당신에게 잘 있어라는 말을 절대로 말하지 않아"},{"from":98.16,"to":102.41,"location":2,"content":"당신에게 거짓말해서 당신을 절대로 아프게 하지 않아"},{"from":102.41,"to":104.5,"location":2,"content":"당신을 절대로 포기하지 않아"},{"from":104.5,"to":106.56,"location":2,"content":"당신을 